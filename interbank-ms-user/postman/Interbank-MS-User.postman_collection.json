{
  "info": {
    "name": "Interbank MS User",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion basica para autenticar y probar endpoints GET de UserController."
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "api",
            "login"
          ]
        },
        "description": "Obtiene token JWT para consumir endpoints protegidos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var json = pm.response.json();",
              "pm.test('Respuesta incluye token', function () {",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - Get All",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/api",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "api"
          ]
        },
        "description": "Lista todos los usuarios. Requiere JWT."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta es arreglo', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - Get By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/api/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "api",
            "{{userId}}"
          ]
        },
        "description": "Obtiene un usuario por id (document). Requiere JWT."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status esperado 200 o 404', function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9091"
    },
    {
      "key": "username",
      "value": "juanperez"
    },
    {
      "key": "password",
      "value": "<TU_PASSWORD>"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": "12345678"
    }
  ]
}

